# Longbridge / LongPort OpenAPI credentials (https://open.longbridge.com)
# Leave blank if they are already exported in your shell (e.g. ~/.bashrc); run.sh ignores empty values.
LONGPORT_APP_KEY=
LONGPORT_APP_SECRET=
LONGPORT_ACCESS_TOKEN=

# Optional overrides (defaults come from config.yaml)
# TRADE_PLAT_HOST=0.0.0.0
# TRADE_PLAT_PORT=8080
# TRADE_PLAT_LOG_LEVEL=INFO
# TRADE_PLAT_LOG_FILE=logs/app.log
